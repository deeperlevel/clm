{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "CMake: Configure (Clang + Ninja)",
            "command": "configure",
            "preset": "default",
            "detail": "Configure the C project with Clang and Ninja.",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "type": "cmake",
            "label": "CMake: Build",
            "command": "build",
            "preset": "default",
            "targets": [
                "main"
            ],
            "dependsOn": "CMake: Configure (Clang + Ninja)",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Build the main C executable."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang.exe build active file",
            "command": "C:\\dev\\llvm\\bin\\clang.exe",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}