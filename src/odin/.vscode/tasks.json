{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Create Odin build directory",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "New-Item -ItemType Directory -Force -Path '${workspaceFolder}\\build' | Out-Null"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build Odin (debug)",
      "type": "process",
      "command": "odin",
      "args": ["build", "..", "-debug", "-out:main.exe"],
      "options": {
        "cwd": "${workspaceFolder}\\build"
      },
      "dependsOn": "Create Odin build directory",
      "problemMatcher": []
    }
  ]
}