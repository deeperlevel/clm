{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare Zig build directory",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "New-Item -ItemType Directory -Force -Path build | Out-Null"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Zig",
      "type": "process",
      "command": "zig",
      "args": [
        "build-exe",
        "main.zig",
        "-O",
        "Debug",
        "-femit-bin=build/main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "Prepare Zig build directory",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
