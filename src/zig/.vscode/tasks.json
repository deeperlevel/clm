{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare Zig build directory",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "New-Item -ItemType Directory -Force -Path build | Out-Null"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Zig",
      "type": "process",
      "command": "zig",
      "args": [
        "build-exe",
        "--dep",
        "clm_console",
        "--dep",
        "clm_base",
        "--dep",
        "clm_bpa",
        "--dep",
        "clm_dictionary",
        "--dep",
        "clm_id",
        "--dep",
        "clm_string",
        "--dep",
        "clm_storage",
        "-Mroot=main.zig",
        "--dep",
        "clm_base",
        "-Mclm_console=clm/console.zig",
        "--dep",
        "clm_base",
        "-Mclm_bpa=clm/bpa.zig",
        "--dep",
        "clm_bpa",
        "-Mclm_dictionary=clm/dictionary.zig",
        "--dep",
        "clm_bpa",
        "--dep",
        "clm_dictionary",
        "-Mclm_id=clm/id.zig",
        "--dep",
        "clm_bpa",
        "-Mclm_string=clm/string.zig",
        "--dep",
        "clm_bpa",
        "-Mclm_storage=clm/storage.zig",
        "-Mclm_base=clm/base.zig",
        "-O",
        "Debug",
        "-femit-bin=build/main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "Prepare Zig build directory",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
