unit clm_gen;
{$mode objfpc}{$H+}
interface
uses SysUtils, Classes;
const GENERATION_SUCCESS=0;GENERATION_FAILURE=1;GENERATION_CASING_MIXED=0;GENERATION_CASING_UPPER=1;GENERATION_CASING_LOWER=2;
function clm_gen_random_u64(min,max:QWord):QWord;
function clm_gen_random_i64(min,max:Int64):Int64;
function clm_gen_random_i8(min,max:ShortInt):ShortInt;
function clm_gen_random_u8(min,max:Byte):Byte;
function clm_gen_random_i16(min,max:SmallInt):SmallInt;
function clm_gen_random_u16(min,max:Word):Word;
function clm_gen_random_i32(min,max:LongInt):LongInt;
function clm_gen_random_u32(min,max:LongWord):LongWord;
function clm_gen_random_f64(min,max:Double):Double;
function clm_gen_random_f32(min,max:Single):Single;
function clm_gen_hex_to(n,c:LongInt;buf:PByte;capacity:NativeUInt):LongInt;
function clm_gen_uuid_to(c:LongInt;buf:PByte;capacity:NativeUInt):LongInt;
function clm_gen_alphanum_to(n,c:LongInt;buf:PByte;capacity:NativeUInt):LongInt;
function clm_gen_strong_password_to(n:LongInt;buf:PByte;capacity:NativeUInt):LongInt;
implementation
procedure SecureBytes(buf:PByte;len:NativeUInt);
var f:TFileStream;
begin f:=TFileStream.Create('/dev/urandom',fmOpenRead or fmShareDenyNone);try if f.Read(buf^,len)<>LongInt(len) then raise Exception.Create('RNG read failure');finally f.Free;end;end;
function NextU64:QWord;begin SecureBytes(@Result,8);end;
function Bounded(bound:QWord):QWord;
var x,threshold:QWord;
begin if bound=0 then Exit(NextU64);threshold:=(QWord(0)-bound) mod bound;repeat x:=NextU64 until x>=threshold;Result:=x mod bound;end;
function clm_gen_random_u64(min,max:QWord):QWord;
var t:QWord;
begin if min>max then begin t:=min;min:=max;max:=t;end;if min=max then Exit(min);Result:=min+Bounded(max-min+1);end;
function clm_gen_random_i64(min,max:Int64):Int64;
var t:Int64;v:QWord;sign:QWord;
begin if min>max then begin t:=min;min:=max;max:=t;end;sign:=QWord(1) shl 63;v:=clm_gen_random_u64(QWord(min) xor sign,QWord(max) xor sign);if v<sign then Result:=Low(Int64)+Int64(v) else Result:=Int64(v-sign);end;
function clm_gen_random_i8(min,max:ShortInt):ShortInt;begin Result:=ShortInt(clm_gen_random_i64(min,max));end;
function clm_gen_random_u8(min,max:Byte):Byte;begin Result:=Byte(clm_gen_random_u64(min,max));end;
function clm_gen_random_i16(min,max:SmallInt):SmallInt;begin Result:=SmallInt(clm_gen_random_i64(min,max));end;
function clm_gen_random_u16(min,max:Word):Word;begin Result:=Word(clm_gen_random_u64(min,max));end;
function clm_gen_random_i32(min,max:LongInt):LongInt;begin Result:=LongInt(clm_gen_random_i64(min,max));end;
function clm_gen_random_u32(min,max:LongWord):LongWord;begin Result:=LongWord(clm_gen_random_u64(min,max));end;
function clm_gen_random_f64(min,max:Double):Double;
var t,u,v:Double;
begin if min>max then begin t:=min;min:=max;max:=t;end;if min=max then Exit(min);u:=(NextU64 shr 11)/9007199254740991.0;if (min<0) and (max>0) then v:=min*(1-u)+max*u else v:=min+(max-min)*u;if v<min then v:=min;if v>max then v:=max;Result:=v;end;
function clm_gen_random_f32(min,max:Single):Single;begin Result:=clm_gen_random_f64(min,max);end;
function Pick(const s:AnsiString):Char;begin Result:=s[Bounded(Length(s))+1];end;
function Valid(c:LongInt):Boolean;begin Result:=(c>=0) and (c<=2);end;
function GenerateText(n,c:LongInt;buf:PByte;capacity:NativeUInt;hex:Boolean):LongInt;
var s:AnsiString;ch:Char;i:LongInt;
begin Result:=GENERATION_FAILURE;if (n<0) or not Valid(c) or (buf=nil) or (capacity<=NativeUInt(n)) then Exit;
if hex then begin if c=1 then s:='0123456789ABCDEF' else s:='0123456789abcdef';end
else if c=1 then s:='0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ' else if c=2 then s:='0123456789abcdefghijklmnopqrstuvwxyz' else s:='0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
for i:=0 to n-1 do begin ch:=Pick(s);if hex and (c=0) and (ch>='a') and (ch<='f') and (Bounded(2)=1) then ch:=Chr(Ord(ch)-32);buf[i]:=Ord(ch);end;buf[n]:=0;Result:=GENERATION_SUCCESS;end;
function clm_gen_hex_to(n,c:LongInt;buf:PByte;capacity:NativeUInt):LongInt;begin Result:=GenerateText(n,c,buf,capacity,True);end;
function clm_gen_alphanum_to(n,c:LongInt;buf:PByte;capacity:NativeUInt):LongInt;begin Result:=GenerateText(n,c,buf,capacity,False);end;
function clm_gen_uuid_to(c:LongInt;buf:PByte;capacity:NativeUInt):LongInt;
var b:array[0..15] of Byte;h:AnsiString;i,p,shift:LongInt;v:Byte;ch:Char;
begin Result:=GENERATION_FAILURE;if not Valid(c) or (buf=nil) or (capacity<37) then Exit;SecureBytes(@b[0],16);b[6]:=(b[6] and 15) or 64;b[8]:=(b[8] and 63) or 128;h:='0123456789abcdef';p:=0;
for i:=0 to 15 do begin if (i=4) or (i=6) or (i=8) or (i=10) then begin buf[p]:=Ord('-');Inc(p);end;for shift:=1 downto 0 do begin v:=(b[i] shr (shift*4)) and 15;ch:=h[v+1];if (ch>='a') and ((c=1) or ((c=0) and (Bounded(2)=1))) then ch:=Chr(Ord(ch)-32);buf[p]:=Ord(ch);Inc(p);end;end;buf[36]:=0;Result:=GENERATION_SUCCESS;end;
function clm_gen_strong_password_to(n:LongInt;buf:PByte;capacity:NativeUInt):LongInt;
var groups:array[0..3] of AnsiString;all,s:AnsiString;i,j:LongInt;t:Byte;
begin Result:=GENERATION_FAILURE;if (n<4) or (buf=nil) or (capacity<=NativeUInt(n)) then Exit;groups[0]:='ABCDEFGHIJKLMNOPQRSTUVWXYZ';groups[1]:='abcdefghijklmnopqrstuvwxyz';groups[2]:='0123456789';groups[3]:='!@#$%^&*()-_=+[]{};:,.?/|~';all:=groups[0]+groups[1]+groups[2]+groups[3];for i:=0 to n-1 do begin if i<4 then s:=groups[i] else s:=all;buf[i]:=Ord(Pick(s));end;for i:=n-1 downto 1 do begin j:=Bounded(i+1);t:=buf[i];buf[i]:=buf[j];buf[j]:=t;end;buf[n]:=0;Result:=GENERATION_SUCCESS;end;
end.
