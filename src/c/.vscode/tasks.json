{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "CMake: Configure (Clang + Ninja)",
            "command": "configure",
            "preset": "default",
            "detail": "Configure the C project with Clang and Ninja.",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "type": "cmake",
            "label": "CMake: Build",
            "command": "build",
            "preset": "default",
            "targets": [
                "main"
            ],
            "dependsOn": "CMake: Configure (Clang + Ninja)",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the main C executable."
        }
    ]
}
